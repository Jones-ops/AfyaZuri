# Copy to .env and fill in. Never commit real secrets.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:54329/afyazuri

# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=
ENCRYPTION_KEY=
BLIND_INDEX_KEY=

SESSION_IDLE_MINUTES=15
LOGIN_MAX_ATTEMPTS=5
LOCKOUT_MINUTES=15
REQUIRE_2FA_PRIVILEGED=false
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
JOBS_ENABLED=true
