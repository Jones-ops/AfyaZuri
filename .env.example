# Afyazuri configuration. Copy to .env, or run `npm run secrets` to create .env with
# every secret below generated for you. Never commit .env.

NODE_ENV=development
PORT=4000

# --- Secrets (generated by `npm run secrets`) -------------------------------------
# Keep a separate, safe copy of ENCRYPTION_KEY, BLIND_INDEX_KEY and BACKUP_KEY:
# without them encrypted fields and backups cannot be read.
JWT_SECRET=
ENCRYPTION_KEY=
BLIND_INDEX_KEY=
BACKUP_KEY=
# Password of the embedded PostgreSQL superuser used by `npm start` (production).
PG_PASSWORD=

# --- Database --------------------------------------------------------------------
# Development (`npm run dev`) uses this. `npm start` builds its own URL from PG_PASSWORD
# unless EXTERNAL_DATABASE_URL points at a separately installed PostgreSQL 16.
DATABASE_URL=postgres://postgres:postgres@localhost:54329/afyazuri
# EXTERNAL_DATABASE_URL=
# PGPORT=54329
# PGDATA_DIR=data/postgres

# --- Sessions and sign-in --------------------------------------------------------
SESSION_IDLE_MINUTES=15
LOGIN_MAX_ATTEMPTS=5
LOCKOUT_MINUTES=15
REQUIRE_2FA_PRIVILEGED=false
CORS_ORIGINS=http://localhost:5173

# --- HTTPS on the LAN (optional; both or neither) ------------------------------------
# TLS_CERT_FILE=certs/afyazuri.crt
# TLS_KEY_FILE=certs/afyazuri.key

# --- Nightly backups (enabled when BACKUP_KEY and BACKUP_DIR are set) ---------------
BACKUP_DIR=backups
# BACKUP_OFFSITE_DIR=E:/afyazuri-backups
# BACKUP_CRON=30 1 * * *
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=4
# BACKUP_KEEP_MONTHLY=12

LOG_LEVEL=info
JOBS_ENABLED=true
# SEED_DEMO=true   # load demo facilities and staff when running `npm start`

# --- M-Pesa (Daraja) ------------------------------------------------------------
# mock = the bundled mock server (npm run mocks / started by npm run dev).
MPESA_ENV=mock
# MPESA_BASE_URL=            # override the Daraja base URL (sandbox/production are built in)
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# Public URL Safaricom can reach for callbacks:
MPESA_CALLBACK_BASE_URL=http://localhost:4000
# Secret path segment authenticating callbacks (generated by `npm run secrets`):
MPESA_CALLBACK_TOKEN=
# Optional: only accept callbacks from these IPs (comma-separated)
# MPESA_CALLBACK_ALLOWED_IPS=
